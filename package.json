{
  "name": "stream-overlay",
  "private": true,
  "workspaces": [
    "apps/*",
    "modules/*",
    "packages/*"
  ],
  "scripts": {
    "overlay": "bun run --parallel overlay:main overlay:pets",
    "overlay:main": "bun --hot server.ts",
    "overlay:pets": "bun --port 3000 streamplace-pets/pets.html"
  }
}
