{
  "name": "stream-overlay",
  "private": true,
  "workspaces": [
    "apps/*",
    "modules/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.0"
  },
  "scripts": {
    "overlay": "bun --hot apps/host/src/server.ts",
    "overlay:legacy": "bun run --parallel overlay:main overlay:pets",
    "overlay:main": "bun --hot server.ts",
    "overlay:pets": "bun --port 3000 streamplace-pets/pets.html",
    "test": "bun test"
  }
}
