{
  "lexicon": 1,
  "id": "live.streamface.chat.settings",
  "defs": {
    "main": {
      "type": "record",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": [
          "enabled",
          "topFadePercent",
          "fontSize",
          "backgroundColor",
          "backgroundOpacity",
          "rotationX",
          "rotationY",
          "perspectiveStrength",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "enabled": { "type": "boolean" },
          "topFadePercent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Spatial fade at the top of the overlay, not message lifetime."
          },
          "fontSize": { "type": "integer", "minimum": 8, "maximum": 72 },
          "backgroundColor": { "type": "string", "minLength": 7, "maxLength": 7 },
          "backgroundOpacity": { "type": "integer", "minimum": 0, "maximum": 100 },
          "rotationX": { "type": "integer", "minimum": -180, "maximum": 180 },
          "rotationY": { "type": "integer", "minimum": -180, "maximum": 180 },
          "perspectiveStrength": { "type": "integer", "minimum": 0, "maximum": 100 },
          "createdAt": { "type": "string", "format": "datetime" },
          "updatedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
