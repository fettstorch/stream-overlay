{
  "lexicon": 1,
  "id": "live.streamface.custommodule",
  "description": "Custom Module overlay with HTML, CSS and JavaScript. Source must be sandboxed.",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["name", "enabled", "html", "css", "createdAt", "updatedAt"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "enabled": { "type": "boolean" },
          "displayMode": { "type": "string", "enum": ["overlay", "page"] },
          "html": { "type": "string", "maxLength": 50000 },
          "css": { "type": "string", "maxLength": 50000 },
          "javascript": { "type": "string", "maxLength": 50000 },
          "bundle": { "type": "ref", "ref": "#bundle" },
          "media": {
            "type": "array",
            "maxLength": 100,
            "items": { "type": "ref", "ref": "#media" }
          },
          "createdAt": { "type": "string", "format": "datetime" },
          "updatedAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "bundle": {
      "type": "object",
      "required": ["name", "blob"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "blob": { "type": "blob", "accept": ["application/zip"], "maxSize": 10000000 }
      }
    },
    "media": {
      "type": "object",
      "required": ["id", "blob"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "blob": {
          "type": "blob",
          "accept": [
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp",
            "image/avif",
            "video/mp4",
            "video/webm",
            "video/quicktime"
          ],
          "maxSize": 10000000
        }
      }
    }
  }
}
