{
  "lexicon": 1,
  "id": "live.streamface.emoticons.defs",
  "defs": {
    "giphyMedia": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "GIPHY GIF ID, resolved directly by the overlay browser. Never a persisted media URL."
        }
      }
    },
    "externalMedia": {
      "type": "object",
      "required": ["url"],
      "properties": { "url": { "type": "string", "format": "uri", "maxLength": 2048 } }
    },
    "uploadedMedia": {
      "type": "object",
      "required": ["blob"],
      "properties": {
        "blob": { "type": "blob", "accept": ["image/*", "video/*", "audio/*"], "maxSize": 10000000 }
      }
    }
  }
}
