{
  "lexicon": 1,
  "id": "live.streamface.emoticons.settings",
  "defs": {
    "main": {
      "type": "record",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["enabled", "createdAt", "updatedAt"],
        "properties": {
          "enabled": { "type": "boolean" },
          "roles": { "type": "ref", "ref": "#roles" },
          "eventMappings": {
            "type": "array",
            "maxLength": 4,
            "items": { "type": "ref", "ref": "#eventMapping" }
          },
          "moderation": {
            "type": "array",
            "maxLength": 200,
            "items": { "type": "ref", "ref": "#moderationRule" }
          },
          "createdAt": { "type": "string", "format": "datetime" },
          "updatedAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "eventMapping": {
      "type": "object",
      "required": ["event", "commandId"],
      "properties": {
        "event": {
          "type": "string",
          "enum": ["teleport-arrival", "teleport-canceled", "stream-started", "stream-ended"]
        },
        "commandId": { "type": "string", "maxLength": 512 },
        "text": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 500,
          "description": "Optional overlay text beneath the event clip."
        }
      }
    },
    "roles": {
      "type": "object",
      "required": ["followers", "mutuals", "moderators", "users"],
      "properties": {
        "followers": { "type": "boolean" },
        "following": {
          "type": "boolean",
          "description": "Allow accounts followed by the streamer."
        },
        "mutuals": { "type": "boolean" },
        "moderators": { "type": "boolean" },
        "users": {
          "type": "array",
          "maxLength": 200,
          "items": { "type": "ref", "ref": "#allowedUser" }
        }
      }
    },
    "allowedUser": {
      "type": "object",
      "required": ["did"],
      "properties": {
        "did": { "type": "string", "format": "did", "maxLength": 2048 },
        "handle": { "type": "string", "maxLength": 253 }
      }
    },
    "moderationRule": {
      "type": "object",
      "required": ["did", "blocked", "cooldownMilliseconds"],
      "properties": {
        "did": { "type": "string", "format": "did", "maxLength": 2048 },
        "handle": { "type": "string", "maxLength": 253 },
        "blocked": { "type": "boolean" },
        "cooldownMilliseconds": { "type": "integer", "minimum": 0, "maximum": 86400000 }
      }
    }
  }
}
